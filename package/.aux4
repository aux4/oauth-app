{
  "scope": "aux4",
  "name": "oauth-app",
  "version": "0.0.8",
  "description": "Core host for deployable OAuth provider plugins (aux4/oauth-app-google, aux4/oauth-app-x). Provides the shared api/oauth machinery and health; each plugin brings its own routes and provider logic.",
  "license": "MIT",
  "tags": [
    "oauth",
    "auth",
    "cloud",
    "core"
  ],
  "dependencies": [
    "aux4/api",
    "aux4/oauth@0.1.5",
    "aux4/config"
  ],
  "system": [
    [
      "test:node --version",
      "brew:node",
      "linux:nodejs"
    ]
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "oauth-app",
          "execute": [
            "profile:oauth-app"
          ],
          "help": {
            "text": "OAuth app core — hosts provider plugins (install e.g. aux4/oauth-app-google)"
          }
        }
      ]
    },
    {
      "name": "oauth-app",
      "commands": [
        {
          "name": "health",
          "execute": [
            "echo '{\"status\":\"ok\"}'"
          ],
          "help": {
            "text": "Liveness check",
            "variables": [
              {
                "name": "params",
                "text": "Path params (from the api runtime)",
                "default": "{}"
              },
              {
                "name": "query",
                "text": "Query params (from the api runtime)",
                "default": "{}"
              },
              {
                "name": "body",
                "text": "Request body (from the api runtime)",
                "default": "{}"
              }
            ]
          }
        },
        {
          "name": "auth-validate",
          "private": true,
          "execute": [
            "node ${packageDir}/lib/auth-validate.mjs values(headers, oauthAppPublic, oauthAppAuth, ssoUrl, cloudVmUrl, oauthAppScope)"
          ],
          "help": {
            "text": "Endpoint auth gate for the api (security.auth.command). SECURE BY DEFAULT; set OAUTH_APP_PUBLIC=true (or OAUTH_APP_AUTH=public) to allow all. When secure, validates the Bearer aux4 idToken via SSO /userinfo and requires the caller to be entitled to this machine's scope.",
            "variables": [
              {
                "name": "headers",
                "text": "Request headers JSON (passed by the api runtime)",
                "default": "{}"
              },
              {
                "name": "cookies",
                "text": "Request cookies JSON (passed by the api runtime; unused)",
                "default": "{}"
              },
              {
                "name": "oauthAppPublic",
                "text": "When 'true', run the broker fully public (no token required)",
                "env": "OAUTH_APP_PUBLIC",
                "default": ""
              },
              {
                "name": "oauthAppAuth",
                "text": "Alternate public toggle: set to 'public' to disable auth",
                "env": "OAUTH_APP_AUTH",
                "default": ""
              },
              {
                "name": "ssoUrl",
                "text": "aux4 SSO base URL used to validate the idToken via <ssoUrl>/userinfo (defaults to https://sso.aux4.io)",
                "env": "AUX4_SSO_URL",
                "default": ""
              },
              {
                "name": "cloudVmUrl",
                "text": "The machine's own public base URL, injected by aux4.cloud (AUX4_CLOUD_VM_URL); the machine scope is its first host label",
                "env": "AUX4_CLOUD_VM_URL",
                "default": ""
              },
              {
                "name": "oauthAppScope",
                "text": "Explicit machine scope, used when AUX4_CLOUD_VM_URL is not available",
                "env": "OAUTH_APP_SCOPE",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "callback",
          "execute": [
            "set:sessionId=nvl(query.state, '')",
            "set:code=nvl(query.code, '')",
            "set:error=nvl(query.error, '')",
            "# Malformed link (no state): render a friendly page and stop. The later steps are guarded to sessionId!=, so they no-op after this. (nvl() gives a clean empty string when a query field is absent, so these checks are reliable.)",
            "if(sessionId==) && node ${packageDir}/lib/callback-page.mjs 'This link has expired. Please go back to where you started and try signing in again.' || if(sessionId!=) && true",
            "# Park the returned code (or error) for the polling client. nout: keeps the park's JSON out of the browser response — the HTML page below is the only body served.",
            "when:${sessionId}!=:nout:aux4 oauth session park --id value(sessionId) param(code) param(error) --dir ${stateDir}/oauth-sessions",
            "# Render the landing page. Three outcomes: success (no error); the user chose not to grant access (access_denied → a neutral, no-fault page); or a real failure.",
            "when:${sessionId}!= && ${error}==:node ${packageDir}/lib/callback-page.mjs",
            "when:${sessionId}!= && ${error}==access_denied:node ${packageDir}/lib/callback-page.mjs --declined",
            "when:${sessionId}!= && ${error}!= && ${error}!=access_denied:node ${packageDir}/lib/callback-page.mjs 'We could not finish. Please close this page and try again.'"
          ],
          "help": {
            "text": "OAuth redirect landing point (shared by every provider). Parks the returned code for the polling CLI, keyed by the session state. Register <machine-url>/api/callback as the redirect URI on each provider app.",
            "variables": [
              {
                "name": "params",
                "text": "Path params (from the api runtime)",
                "default": "{}"
              },
              {
                "name": "query",
                "text": "Query params — code, state, error (from the provider redirect)",
                "default": "{}"
              },
              {
                "name": "body",
                "text": "Request body (unused here)",
                "default": "{}"
              },
              {
                "name": "stateDir",
                "text": "Base dir the cloud-file-sync keeps in S3; the session store lives under <stateDir>/oauth-sessions",
                "env": "CLOUD_STATE_DIR",
                "default": "/tmp/state"
              }
            ]
          }
        },
        {
          "name": "poll",
          "execute": [
            "set:sessionId=${params.id}",
            "if(sessionId==) && echo '{\"status\":\"invalid\"}' && exit 0 || if(sessionId!=) && true",
            "aux4 oauth session poll --id value(sessionId) --dir ${stateDir}/oauth-sessions"
          ],
          "help": {
            "text": "Poll a pending login session. Returns {status: pending|ready|error|expired} and the code when ready (single-use). The CLI polls this until it gets the code, then calls the provider's exchange route.",
            "variables": [
              {
                "name": "params",
                "text": "Path params — id (the session id)",
                "default": "{}"
              },
              {
                "name": "query",
                "text": "Query params (unused here)",
                "default": "{}"
              },
              {
                "name": "body",
                "text": "Request body (unused here)",
                "default": "{}"
              },
              {
                "name": "stateDir",
                "text": "Base dir the cloud-file-sync keeps in S3; the session store lives under <stateDir>/oauth-sessions",
                "env": "CLOUD_STATE_DIR",
                "default": "/tmp/state"
              }
            ]
          }
        }
      ]
    }
  ]
}
